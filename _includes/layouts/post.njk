---
layout: layouts/base.njk
---
<style>{% include "node_modules/prismjs/themes/prism-okaidia.css" %}</style>
<style>{% include "public/css/prism-diff.css" %}</style>

<article class="post-article">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    <div class="post-meta">
      <time datetime="{{ page.date | htmlDateString }}" class="post-date">
        {{ page.date | readableDate }}
      </time>
      {%- if tags | filterTagList | length %}
      <span class="post-tags">
        {%- for tag in tags | filterTagList %}
        {%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
        <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}
        {%- endfor %}
      </span>
      {%- endif %}
    </div>
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>

  {%- if collections.posts %}
  {%- set previousPost = collections.posts | getPreviousCollectionItem %}
  {%- set nextPost = collections.posts | getNextCollectionItem %}
  {%- if nextPost or previousPost %}
  <nav class="post-nav" aria-label="Previous and next posts">
    <ul>
      {%- if previousPost %}
      <li class="post-nav-prev">
        <span class="post-nav-label">← Previous</span>
        <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a>
      </li>
      {%- endif %}
      {%- if nextPost %}
      <li class="post-nav-next">
        <span class="post-nav-label">Next →</span>
        <a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a>
      </li>
      {%- endif %}
    </ul>
  </nav>
  {%- endif %}
  {%- endif %}
</article>
