<ol class="postlist" reversed>
  {%- for post in postslist | reverse %}
  <li class="postlist-item{% if post.url == url %} postlist-item-active{% endif %}">
    <article class="post-card">
      <h2 class="post-card-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
      <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">
        {{ post.date | readableDateShort }}
      </time>
      {%- if post.data.description %}
      <p class="post-card-desc">{{ post.data.description }}</p>
      {%- endif %}
      {%- if post.data.tags | filterTagList | length %}
      <div class="post-card-tags">
        {%- for tag in post.data.tags | filterTagList %}
        <a href="/tags/{{ tag | slugify }}/" class="post-card-tag">{{ tag }}</a>
        {%- endfor %}
      </div>
      {%- endif %}
    </article>
  </li>
  {%- endfor %}
</ol>
